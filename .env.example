# Create a bot with https://t.me/BotFather, then set its token in .env.
TELEGRAM_BOT_TOKEN=

# Embedding provider: huggingface (free local BGE-M3), ollama, or azure.
SIGNAL_EMBEDDING_PROVIDER=huggingface

# Azure OpenAI embeddings (switch SIGNAL_EMBEDDING_PROVIDER to azure).
# Endpoint is the Azure resource endpoint; use the deployment name, not the model ID.
AZURE_OPENAI_ENDPOINT=https://ecebot-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=ece-bot-embeddings

# Local LLM uses environment variables (these lines document the defaults).
# Start-Signal.ps1 -NoLLM disables generation without changing the index.
# SIGNAL_LLM=on
# SIGNAL_OLLAMA_URL=http://127.0.0.1:11434
